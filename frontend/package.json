{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "check:ui": "vite build --ssr scripts/ui-check.tsx --outDir .ui-check --emptyOutDir --logLevel error && node .ui-check/ui-check.js",
    "check:agui": "vite build --ssr scripts/agui-pipeline-check.ts --outDir .agui-check --emptyOutDir --logLevel error && node .agui-check/agui-pipeline-check.js",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@ag-ui/client": "0.0.59",
    "@assistant-ui/react": "^0.15.27",
    "@assistant-ui/react-ag-ui": "^0.0.67",
    "@assistant-ui/react-markdown": "^0.14.20",
    "@base-ui/react": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.55.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "tw-shimmer": "^0.4.13",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
